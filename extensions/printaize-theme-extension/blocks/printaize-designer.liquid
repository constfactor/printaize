<div class="printaize-container">
  <h2>{{ block.settings.heading }}</h2>
  
  <div id="printaize-root"></div>
  
  <script>
    // Remixアプリをロード
    (function() {
      // 既にスクリプトがロードされている場合はスキップ
      if (window.PrintAIzeLoaded) return;
      window.PrintAIzeLoaded = true;
      
      // Remixアプリのエントリーポイントをロード
      const script = document.createElement('script');
      script.src = 'https://printaize.vercel.app/build/entry.client.js';
      script.type = 'module';
      document.body.appendChild(script);
    })();
  </script>
</div>

<style>
  .printaize-container {
    width: 100%;
    padding: 20px 0;
  }
  
  #printaize-root {
    width: 100%;
    min-height: 600px;
  }
</style>

{% schema %}
{
  "name": "PrintAIze Designer",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design Your Custom Print"
    }
  ]
}
{% endschema %}
