<div class="printaize-block">
  {% if block.settings.heading != blank %}
    <h2>{{ block.settings.heading }}</h2>
  {% endif %}
  
  <div id="printaize-app"></div>
</div>

{% schema %}
{
  "name": "PrintAIze Designer",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design Your Custom Print"
    }
  ]
}
{% endschema %}
